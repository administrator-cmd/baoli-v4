digraph G {
graph [rankdir=LR, bgcolor="transparent", pad="0.25", nodesep="0.60", ranksep="1.15", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Microsoft YaHei"];
edge [dir=none, fontname="Microsoft YaHei", fontsize=13, color="#8c9bad", fontcolor="#4b5b71", penwidth=1.3];
audit_task [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>审核任务</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">audit_task</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">UK  task_no</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">status</FONT></TD></TR></TABLE>>];
scenario_node [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>执行容器节点</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">scenario_node</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">node_code</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">node_type</FONT></TD></TR></TABLE>>];
node_execution [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>执行批次</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">node_execution</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">sequence_no</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">status</FONT></TD></TR></TABLE>>];
audit_report [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>审核报告快照</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">audit_report</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">UK  report_no</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">report_name</FONT></TD></TR></TABLE>>];
rule_result [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>规则执行结果</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">rule_result</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">rule_key</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">rule_code ?</FONT></TD></TR></TABLE>>];
field_review_confirmation [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>字段核对确认</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">field_review_confirmation</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">UK  confirmation_no</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">input_revision</FONT></TD></TR></TABLE>>];
audit_task -> node_execution [label="R01   1 : 0..N", tooltip="fk_node_execution_task_version"];
scenario_node -> node_execution [label="R02   1 : 0..N", tooltip="fk_node_execution_version_node"];
node_execution -> audit_report [label="R03   0..1 : 0..N", tooltip="fk_audit_report_execution_task"];
audit_task -> audit_report [label="R04   1 : 0..N", tooltip="fk_audit_report_task"];
node_execution -> rule_result [label="R05   1 : 0..N", tooltip="fk_rule_result_execution_task"];
audit_task -> rule_result [label="R06   1 : 0..N", tooltip="fk_rule_result_task"];
node_execution -> field_review_confirmation [label="R07   1 : 0..N", tooltip="fk_field_review_execution_task"];
audit_task -> field_review_confirmation [label="R08   1 : 0..N", tooltip="fk_field_review_task"];
}