digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.60", ranksep="1.15", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Microsoft YaHei"];
edge [dir=none, fontname="Microsoft YaHei", fontsize=13, color="#8c9bad", fontcolor="#4b5b71", penwidth=1.3];
node_execution [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>执行批次</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">node_execution</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">sequence_no</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">status</FONT></TD></TR></TABLE>>];
task_document [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>任务材料位</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">task_document</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">UK  document_no</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">material_key</FONT></TD></TR></TABLE>>];
audit_task [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>审核任务</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">audit_task</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">UK  task_no</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">status</FONT></TD></TR></TABLE>>];
document_upload [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>上传文件版本</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">document_upload</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">upload_no</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">is_current</FONT></TD></TR></TABLE>>];
task_field_value [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>字段取值索引</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">task_field_value</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">field_key</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">revision_no</FONT></TD></TR></TABLE>>];
manual_review [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>人工复核记录</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">manual_review</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">UK  review_no</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">decision ?</FONT></TD></TR></TABLE>>];
node_execution -> task_field_value [label="R01   0..1 : 0..N", tooltip="fk_task_field_value_execution_task"];
task_document -> task_field_value [label="R02   1 : 0..N", tooltip="fk_task_field_value_task_material"];
audit_task -> task_field_value [label="R03   1 : 0..N", tooltip="fk_task_field_value_task_version"];
document_upload -> task_field_value [label="R04   1 : 0..N", tooltip="fk_task_field_value_upload_task"];
task_field_value -> manual_review [label="R05   1 : 0..N", tooltip="fk_manual_review_field_value_task"];
audit_task -> manual_review [label="R06   1 : 0..N", tooltip="fk_manual_review_task"];
}