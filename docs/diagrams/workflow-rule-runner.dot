// Regenerate: neato -n2 -Tsvg workflow-rule-runner.dot -o workflow-rule-runner.svg
digraph Workflow {
  graph [bgcolor="white", pad=0.22, splines=polyline, overlap=true, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fixedsize=true, fontname="Microsoft YaHei", fontcolor="#19344a", penwidth=1.1, margin=0];
  edge [color="#718b9b", arrowsize=0.65, penwidth=1.2];
  title [pos="451,-26!", width=0.000, height=0.000, shape=plain, fixedsize=false, style="", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#19344a"><B>13   规则执行器与批量抽取</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">图 12 的第 05 步：按依赖顺序串行调度，当前组保存结果后再处理下一组。</FONT></TD></TR></TABLE>>];
  dispatch [pos="450,-98!", width=8.889, height=0.944, fillcolor="#eef5fb", color="#8eafca", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>读取本轮计划，选择下一条或下一组</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">仅相邻、同材料同产物、无输入依赖且符合合批条件的单字段抽取（至少两条）走 C；其余走单条执行。</FONT></TD></TR></TABLE>>];
  local [pos="147,-222!", width=3.736, height=1.528, fillcolor="#e9f6f1", color="#7eafa0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>A   单条：程序直接处理</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">材料质量阻断 → 记为未执行。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">组合汇总 → 根据来源规则生成结论。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">比较或计算缺必要取值 → 记为证据不足。</FONT></TD></TR></TABLE>>];
  sources [pos="450,-222!", width=3.736, height=1.528, fillcolor="#eef5fb", color="#8eafca", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>B   单条：准备模型输入</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">比较、计算从 values.csv 取当前有效值。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">风险、报告读上游；抽取预读材料。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">只声明材料范围的正文比较预读 OCR。</FONT></TD></TR></TABLE>>];
  batch [pos="753,-222!", width=3.736, height=1.528, fillcolor="#eef5fb", color="#8eafca", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>C   批量：一次预读材料</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">同一份 OCR 或印章产物只读取一次。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">为每个字段分配短编号，</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">连同各自的抽取要求组成一次请求。</FONT></TD></TR></TABLE>>];
  dispatch -> local [color="#718b9b", pos="e,147,-167 335,-132 335,-137.33 335,-142.67 335,-148 272.33,-148 209.67,-148 147,-148 147,-152 147,-156 147,-160"];
  dispatch -> sources;
  dispatch -> batch [color="#718b9b", pos="e,753,-167 565,-132 565,-137.33 565,-142.67 565,-148 627.67,-148 690.33,-148 753,-148 753,-152 753,-156 753,-160"];
  model [pos="450,-341!", width=3.736, height=0.944, fillcolor="#eef5fb", color="#8eafca", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>调用模型</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">比较、计算、风险、报告均不提供工具。</FONT></TD></TR></TABLE>>];
  batchmodel [pos="753,-341!", width=3.736, height=0.944, fillcolor="#eef5fb", color="#8eafca", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>无工具请求，返回 JSON</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">一批字段共用一次初始模型调用。</FONT></TD></TR></TABLE>>];
  sources -> model;
  batch -> batchmodel;
  check [pos="450,-457!", width=3.736, height=1.375, fillcolor="#f3eff8", color="#b29bc8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>处理工具或校验结论</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">允许工具时：执行调用，回传结果。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">结论不合格时：按错误修正。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">有效、阻断或达到轮次上限时结束。</FONT></TD></TR></TABLE>>];
  batchcheck [pos="753,-457!", width=3.736, height=1.375, fillcolor="#f3eff8", color="#b29bc8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>校验字段身份、结构与引文</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">整批格式错：纠正整批回复。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">字段错、重复或漏项：只纠正问题字段。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">两类错误合计最多一次修正。</FONT></TD></TR></TABLE>>];
  model -> check;
  batchmodel -> batchcheck;
  check -> model [color="#896ba6", pos="e,315,-340 315,-456 309.67,-456 304.33,-456 299,-456 299,-417.33 299,-378.67 299,-340 302,-340 305,-340 308,-340"];
  batchcheck -> batchmodel [color="#896ba6", pos="e,888,-340 888,-456 892.67,-456 897.33,-456 902,-456 902,-417.33 902,-378.67 902,-340 899.67,-340 897.33,-340 895,-340"];
  localout [pos="147,-568!", width=3.736, height=0.944, fillcolor="#e9f6f1", color="#7eafa0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>保存程序处理结果</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">不发模型请求，保留状态及原因。</FONT></TD></TR></TABLE>>];
  singleout [pos="450,-568!", width=3.736, height=0.944, fillcolor="#e9f6f1", color="#7eafa0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>保存单条结果</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">保存规则结论或本条未执行原因。</FONT></TD></TR></TABLE>>];
  batchout [pos="753,-568!", width=3.736, height=0.944, fillcolor="#e9f6f1", color="#7eafa0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>逐字段保存</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">已通过的保留；剩余失败各自记录。</FONT></TD></TR></TABLE>>];
  local -> localout;
  check -> singleout;
  batchcheck -> batchout;
  next [pos="450,-675!", width=9.889, height=1.028, fillcolor="#f2f5f6", color="#afbdc6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>调度下一组，或返回任务图收尾</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">普通单项失败：继续。模型渠道故障：先记录原因，再停止后续调度；已提交的结果保留。</FONT></TD></TR></TABLE>>];
  localout -> next;
  singleout -> next;
  batchout -> next;
}
