// Regenerate: neato -n2 -Tsvg workflow-langgraph-task.dot -o workflow-langgraph-task.svg
digraph Workflow {
  graph [bgcolor="white", pad=0.22, splines=polyline, overlap=true, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fixedsize=true, fontname="Microsoft YaHei", fontcolor="#19344a", penwidth=1.1, margin=0];
  edge [color="#718b9b", arrowsize=0.65, penwidth=1.2];
  title [pos="467,-22!", width=0.000, height=0.000, shape=plain, fixedsize=false, style="", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#19344a"><B>12   审核任务的八个 LangGraph 节点</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">箭头表示一次图调用的方向；字段核对与故障续跑在本次调用结束后进行。</FONT></TD></TR></TABLE>>];
  load_task [pos="158,-104!", width=2.611, height=1.042, fillcolor="#eef5fb", color="#8eafca", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>01   读取任务</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#526a7b">load_task</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">定位当前业务节点</FONT></TD></TR></TABLE>>];
  execute_current_node [pos="371,-104!", width=2.611, height=1.042, fillcolor="#eef5fb", color="#8eafca", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>02   进入执行批次</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#526a7b">execute_current_node</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">建立或接续执行记录</FONT></TD></TR></TABLE>>];
  prepare_materials [pos="584,-104!", width=2.611, height=1.042, fillcolor="#eef5fb", color="#8eafca", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>03   准备材料</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#526a7b">prepare_materials</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">前置质量检查、复用就绪产物</FONT></TD></TR></TABLE>>];
  load_evaluation [pos="797,-104!", width=2.611, height=1.042, fillcolor="#eef5fb", color="#8eafca", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>04   加载执行计划</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#526a7b">load_evaluation</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">按依赖与核对状态划定范围</FONT></TD></TR></TABLE>>];
  execute_rules [pos="797,-246!", width=2.611, height=1.042, fillcolor="#e9f6f1", color="#7eafa0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>05   执行本轮规则</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#526a7b">execute_rules</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">串行调度；内部流程见图 13</FONT></TD></TR></TABLE>>];
  finalize_node_execution [pos="584,-246!", width=2.611, height=1.042, fillcolor="#fff5e9", color="#c9a272", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>06   汇总批次</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#526a7b">finalize_node_execution</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">合并本轮与已有逐条结果</FONT></TD></TR></TABLE>>];
  advance_workflow [pos="371,-246!", width=2.611, height=1.042, fillcolor="#eef5fb", color="#8eafca", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>07   判断是否推进</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#526a7b">advance_workflow</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">按批次状态更新工作流</FONT></TD></TR></TABLE>>];
  save_node_result [pos="158,-246!", width=2.611, height=1.042, fillcolor="#eef5fb", color="#8eafca", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>08   保存节点结果</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#526a7b">save_node_result</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">提交任务进度并返回</FONT></TD></TR></TABLE>>];
  start [pos="24,-104!", width=0.764, height=0.375, fillcolor="#f2f5f6", color="#afbdc6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#526a7b">START</FONT></TD></TR></TABLE>>];
  end [pos="24,-246!", width=0.764, height=0.375, fillcolor="#f2f5f6", color="#afbdc6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#526a7b">END</FONT></TD></TR></TABLE>>];
  start -> load_task;
  load_task -> execute_current_node;
  execute_current_node -> prepare_materials;
  prepare_materials -> load_evaluation;
  load_evaluation -> execute_rules;
  execute_rules -> finalize_node_execution;
  finalize_node_execution -> advance_workflow;
  advance_workflow -> save_node_result;
  save_node_result -> end;
  execute_current_node -> save_node_result [color="#aa7036", pos="e,158,-208 371,-142 371,-154.33 371,-166.67 371,-179 300,-179 229,-179 158,-179 158,-186.33 158,-193.67 158,-201"];
  bypass_note [pos="264,-165!", width=0.000, height=0.000, shape=plain, fixedsize=false, style="", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#945c2b">返回 last_error：直接收尾</FONT></TD></TR></TABLE>>];
  state_title [pos="438,-320!", width=0.000, height=0.000, shape=plain, fixedsize=false, style="", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#19344a"><B>06  如何决定批次状态？  按下列顺序判定，命中后停止。</B></FONT></TD></TR></TABLE>>];
  channel [pos="100,-388!", width=2.917, height=1.069, fillcolor="#fff5e9", color="#c9a272", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>1   渠道故障</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">批次阻断，停止发新请求。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">已提交结果保留。</FONT></TD></TR></TABLE>>];
  review [pos="323,-388!", width=2.917, height=1.069, fillcolor="#eef5fb", color="#8eafca", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>2   等待字段核对</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">抽取段收尾，等待人工确认。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">可以带着缺项继续。</FONT></TD></TR></TABLE>>];
  incomplete [pos="546,-388!", width=2.917, height=1.069, fillcolor="#fff5e9", color="#c9a272", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>3   规则未完成</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">汇总未执行或阻断项，</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">记录具体原因。</FONT></TD></TR></TABLE>>];
  success [pos="769,-388!", width=2.917, height=1.069, fillcolor="#e9f6f1", color="#7eafa0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#19344a"><B>4   批次成功</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">该批次执行完成；</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">业务可有异常或证据不足。</FONT></TD></TR></TABLE>>];
  resume [pos="436,-471!", width=12.167, height=0.833, fillcolor="#f2f5f6", color="#afbdc6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#19344a"><B>下次调用怎样接着跑？</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#526a7b">字段确认后进入核对后段；故障恢复时按持久化结果选取未完成项及受影响的下游。图不保存模型对话或 LangGraph checkpoint。</FONT></TD></TR></TABLE>>];
}
