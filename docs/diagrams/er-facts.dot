task_fact [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>统一事实索引</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">task_fact</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">fact_code</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">fact_kind</FONT></TD></TR></TABLE>>];
