digraph G {
graph [rankdir=LR, bgcolor="transparent", pad="0.25", nodesep="0.60", ranksep="1.15", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Microsoft YaHei"];
edge [dir=none, fontname="Microsoft YaHei", fontsize=13, color="#8c9bad", fontcolor="#4b5b71", penwidth=1.3];
scenario_template [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>场景</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">scenario_template</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">UK  scenario_code</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">scenario_name</FONT></TD></TR></TABLE>>];
scenario_version [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>已发布场景版本</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">scenario_version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">scenario_code</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">version_no</FONT></TD></TR></TABLE>>];
import_job [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>规则库导入作业</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">import_job</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">UK  job_no</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">status</FONT></TD></TR></TABLE>>];
scenario_node [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>执行容器节点</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">scenario_node</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">node_code</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">node_type</FONT></TD></TR></TABLE>>];
audit_plan [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>审核方案</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">audit_plan</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">UK  plan_code</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">plan_name</FONT></TD></TR></TABLE>>];
scenario_draft [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>场景草稿</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">scenario_draft</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">revision_no</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">config_json</FONT></TD></TR></TABLE>>];
audit_task [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#eff4fb"><FONT POINT-SIZE="18" COLOR="#15253c"><B>审核任务</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#2563eb">audit_task</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">UK  task_no</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">status</FONT></TD></TR></TABLE>>];
scenario_template -> import_job [label="R01   0..1 : 0..N", tooltip="fk_import_job_template"];
scenario_version -> scenario_version [label="R02   0..1 : 0..N", tooltip="fk_scenario_version_base"];
import_job -> scenario_version [label="R03   0..1 : 0..1", tooltip="fk_scenario_version_import_job"];
scenario_version -> scenario_node [label="R04   1 : 0..N", tooltip="fk_scenario_node_version"];
scenario_template -> scenario_draft [label="R05   1 : 0..1", tooltip="fk_scenario_draft_template"];
scenario_version -> audit_plan [label="R06   0..1 : 0..N", tooltip="fk_audit_plan_scenario_version"];
scenario_node -> audit_task [label="R07   1 : 0..N", tooltip="fk_audit_task_current_node"];
audit_plan -> audit_task [label="R08   0..1 : 0..N", tooltip="fk_audit_task_plan"];
scenario_version -> audit_task [label="R09   1 : 0..N", tooltip="fk_audit_task_scenario_version"];
}