# baoli-v4 本地运行配置。复制为项目根目录 .env 后填写；真实 .env 不可提交。
# 进程环境变量优先于本文件；相对路径均以 baoli-v4 项目根目录为基准。
# 留空表示未配置，系统状态会列出缺失项；不要以示例文本替代真实服务地址、模型或密钥。

# MySQL 连接必须明确指向 baoli_v4 或 baoli_v4_dev。填写格式：mysql+pymysql://USER:PASSWORD@HOST:3306/baoli_v4?charset=utf8mb4；密码中的 @、:、/ 等字符需按 SQLAlchemy URL 规则百分号编码。
BAOLI_DATABASE_URL=

# 应用名称与接口前缀；修改接口前缀时需同步前端请求地址。
BAOLI_APP_NAME=保理合同审核验证版
BAOLI_API_PREFIX=/api

# 工作簿 IR 预览：行数 1–200、列数 1–40、单元格字符数 1–500。
# 仅影响预览与表头候选，不是模型读取业务行的分批大小。
BAOLI_WORKBOOK_PREVIEW_ROWS=200
BAOLI_WORKBOOK_PREVIEW_COLUMNS=40
BAOLI_WORKBOOK_CELL_CHARS=500

# 本地上传与处理产物目录；data 表示项目根目录下的 data。
BAOLI_DATA_DIR=data
# 业务规则和字段来自场景 JSON，不使用固定 Excel 模板。
# --- 上传入口体量上限 ----------------------------------------------------------
# 两者互相独立，不能共用一个值：规则库是 Excel 配置表，业务材料是合同/协议扫描件。
# 只校验为正数，没有写死的上界；真实环境里几十 MiB 的扫描件是正常的。
# 单位是字节。默认：规则库 30 MiB，业务材料 128 MiB。
# 这里只约束**本系统的上传入口**；8018、8010、OCR 与部署入口各自的体量上限
# 是独立的外部契约，本配置不构成对它们的承诺。
# 前端展示的大小上限与允许扩展名来自只读接口 GET /api/system/upload-policy。
BAOLI_MAX_RULEBOOK_BYTES=31457280
BAOLI_MAX_DOCUMENT_BYTES=134217728
# 后端日志等级：DEBUG、INFO、WARNING、ERROR、CRITICAL。
BAOLI_LOG_LEVEL=INFO
# 普通 8018、8010、印章或 OCR HTTP 请求的超时秒数，不是 OCR 整体操作时限。
BAOLI_REQUEST_TIMEOUT_SECONDS=600
# LLM 流式响应的读取超时：连续这么多秒没有收到任何数据才判定请求卡住。
# 默认 900 秒（15 分钟）；模型只要还在持续输出，就不会被这个时限截断。
BAOLI_LLM_TIMEOUT_SECONDS=900
# 单次模型请求（含自动重试）的总时限，只用于兜住永不结束的流。默认 7200 秒（2 小时）。
# 规则库解析等真实耗时超过它时按实际耗时调大；这与「网络不可达」不是一回事。
BAOLI_LLM_MAX_SECONDS=7200
# 同进程所有模型入口串行请求，上一轮结束后到下一轮的最短间隔；0 关闭间隔。
BAOLI_LLM_REQUEST_INTERVAL_SECONDS=2
# 429/502/503/504 的重试基数；按 10/20/40 秒增长并增加至多 20% 抖动。
# 若 Retry-After 要求等待更久则遵守；最多仍是首次请求加三次重试。
BAOLI_LLM_RETRY_BASE_SECONDS=10

# OpenAI Chat Completions 兼容大模型。填写基础地址或完整 /chat/completions 地址。
BAOLI_LLM_BASEURL=
BAOLI_LLM_APIKEY=
BAOLI_LLM_MODEL_NAME=
# 工具调用循环的轮数上限。模型反复请求工具时必须有终止条件，但达到上限是**显式失败**
# （错误码 LLM_TOOL_LOOP_LIMIT，并带上完整调用历史），不会把「跑到上限」当作结论。
# 0 表示不设上限，由调用方自行控制终止。默认 12。
BAOLI_LLM_TOOL_MAX_ROUNDS=12
# 单次模型请求的最大输出 token 数。不传时供应商可能使用较小的默认值，导致长响应被截断。
# 默认 393216，即 deepseek-v4.1-flash 的 384K 上限；换成其他模型时按该模型上限调整，
# 超过上限供应商会直接返回 400。
BAOLI_LLM_MAX_OUTPUT_TOKENS=393216

# 8018 材料类型校验服务基础地址；填写后执行文件处理时会请求 /supported-types 与 /validate。
BAOLI_SERVICE_8018_URL=
# 8010 文档处理服务基础地址；执行文件处理时会请求 /process。
BAOLI_SERVICE_8010_URL=
# 8003 印章识别服务基础地址；执行文件处理时会请求 /predict。
BAOLI_SEAL_SERVICE_URL=

# PaddleOCR 的完整提交接口地址；填写后不会自动附加路径。
BAOLI_OCR_SERVICE_URL=
BAOLI_OCR_TOKEN=
BAOLI_OCR_MODEL=
# OCR 轮询间隔秒数，以及提交、轮询、结果下载共用的总等待秒数。
BAOLI_OCR_POLL_INTERVAL_SECONDS=5
BAOLI_OCR_MAX_WAIT_SECONDS=600

# 规则库两轮解析推理强度；留空采用供应商默认，low 保留低强度推理。
BAOLI_RULEBOOK_LLM_REASONING_EFFORT=low
