# 真实本地配置；.env.example 是可提交的配置说明。
.env
.env.*
!.env.example

# 本地业务数据与日志。
data/
logs/
*.log

# Python 本地缓存和虚拟环境。
__pycache__/
*.py[cod]
.venv/
venv/
env/

# 前端依赖和构建产物。
frontend/node_modules/
frontend/dist/

# 临时脚本与临时产物；需长期保留的放 script/。
tmp/

# 本地验收产物：模型请求与响应、截图、浏览器快照和导出样本。
/output/
/.playwright-cli/
